# NABO Tab5 Kconfig fragment
CONFIG_IDF_TARGET="esp32p4"
CONFIG_ESPTOOLPY_FLASHSIZE_16MB=y
CONFIG_ESPTOOLPY_FLASHMODE_QIO=y
CONFIG_ESPTOOLPY_FLASHFREQ_80M=y

CONFIG_SPIRAM=y
CONFIG_SPIRAM_SPEED_200M=y
CONFIG_SPIRAM_ALLOW_STACK_EXTERNAL_MEMORY=y

CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions/nabo_tab5.csv"

CONFIG_BOARD_TYPE_NABO_TAB5=y
CONFIG_NABO_PANEL_ST7121=y

CONFIG_FREERTOS_HZ=1000
CONFIG_ESP_MAIN_TASK_STACK_SIZE=8192
CONFIG_ESP_SYSTEM_EVENT_TASK_STACK_SIZE=4096

# LVGL 720p — enable the widgets used by the NABO settings UI
CONFIG_LV_COLOR_DEPTH_16=y
CONFIG_LV_USE_LIST=y
CONFIG_LV_USE_KEYBOARD=y
CONFIG_LV_USE_SPINNER=y

CONFIG_FATFS_LFN_HEAP=y
CONFIG_FATFS_API_ENCODING_UTF_8=y
CONFIG_FATFS_MAX_LFN=255

# Wi-Fi via ESP32-C6 (hosted / remote) — enable when integrating xiaozhi tree
# CONFIG_ESP_WIFI_REMOTE_ENABLED=y
